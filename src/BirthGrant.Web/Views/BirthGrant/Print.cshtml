@model BirthGrant.Web.Models.BirthGrantPrintViewModel
@{
    Layout = null;
    var c = Model.Case;
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>生育獎勵金申請表</title>
    <style>
        @@page {
            size: A4;
            margin: 12mm;
        }

        body {
            font-family: "Microsoft JhengHei", Arial, sans-serif;
            margin: 0;
            color: #000;
        }

        .toolbar {
            padding: 12px;
            background: #f5f5f5;
            border-bottom: 1px solid #ccc;
        }

        .sheet {
            width: 100%;
            page-break-after: always;
            border: 1px solid #999;
            padding: 16px;
            box-sizing: border-box;
            min-height: 260mm;
        }

        .title {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .sub-title {
            text-align: center;
            font-size: 16px;
            margin-bottom: 16px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        td {
            border: 1px solid #333;
            padding: 6px 8px;
            vertical-align: top;
        }

        .label {
            width: 22%;
            background: #fafafa;
            font-weight: bold;
        }

        .qr-box {
            width: 120px;
            height: 120px;
            border: 1px solid #333;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .footer-note {
            margin-top: 12px;
            font-size: 13px;
            line-height: 1.7;
        }

        .sign-line {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            font-size: 14px;
        }

        @@media print {
            .toolbar {
                display: none;
            }
            .sheet {
                border: none;
            }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button onclick="window.print()">列印</button>
        <a href="/BirthGrant/Index">返回開始頁</a>
    </div>

    <div class="sheet">
        <div class="title">新北市○○戶政事務所115年度發放生育獎勵金申請表</div>
        <div class="sub-title">戶政事務所存根聯</div>

        <table>
            <tr>
                <td class="label">案號</td>
                <td>@c.CaseNo</td>
                <td class="label">申請日期</td>
                <td>@c.ApplyDate.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <td class="label">新生兒身分證字號</td>
                <td>@c.ChildIdNo</td>
                <td class="label">新生兒姓名</td>
                <td>@c.ChildName</td>
            </tr>
            <tr>
                <td class="label">設籍人身分證字號</td>
                <td>@c.ApplicantIdNo</td>
                <td class="label">設籍人姓名</td>
                <td>@c.ApplicantName</td>
            </tr>
            <tr>
                <td class="label">設籍人電話</td>
                <td>@c.ApplicantPhone</td>
                <td class="label">設籍日期</td>
                <td>@(c.ApplicantRegisterDate?.ToString("yyyy-MM-dd") ?? "")</td>
            </tr>
            <tr>
                <td class="label">戶籍地址</td>
                <td colspan="3">@c.ApplicantAddress</td>
            </tr>
            <tr>
                <td class="label">配偶資料</td>
                <td colspan="3">@c.SpouseName @c.SpouseIdNo</td>
            </tr>
            <tr>
                <td class="label">受託人資料</td>
                <td colspan="3">@c.AgentName @c.AgentIdNo</td>
            </tr>
            <tr>
                <td class="label">受款人</td>
                <td>@c.PayeeName</td>
                <td class="label">領取方式</td>
                <td>@c.PaymentMethod</td>
            </tr>
            <tr>
                <td class="label">金融行庫代碼</td>
                <td>@c.BankCode</td>
                <td class="label">金融帳號</td>
                <td>@c.BankAccount</td>
            </tr>
            <tr>
                <td class="label">核發金額</td>
                <td>@c.GrantAmount</td>
                <td class="label">收件人</td>
                <td>System</td>
            </tr>
        </table>

        <div class="footer-note">
            ※ 本申請資料如有虛報不實，申請人願負一切法律責任。<br />
            ※ 因申請生育獎勵金，申請人同意提供個人資料供審核使用。
        </div>

        <div class="sign-line">
            <div>申請人(簽名或蓋章)：____________</div>
            <div>受託人(簽名或蓋章)：____________</div>
        </div>
    </div>

    <div class="sheet">
        <div class="title">新北市○○戶政事務所115年度發放生育獎勵金申請表</div>
        <div class="sub-title">申請者收執聯</div>

        <table>
            <tr>
                <td class="label">案號</td>
                <td>@c.CaseNo</td>
                <td class="label">申請日期</td>
                <td>@c.ApplyDate.ToString("yyyy-MM-dd")</td>
            </tr>
            <tr>
                <td class="label">新生兒姓名</td>
                <td>@c.ChildName</td>
                <td class="label">子女數</td>
                <td>第 @c.ChildOrder 名</td>
            </tr>
            <tr>
                <td class="label">設籍人姓名</td>
                <td>@c.ApplicantName</td>
                <td class="label">設籍人電話</td>
                <td>@c.ApplicantPhone</td>
            </tr>
            <tr>
                <td class="label">核發金額</td>
                <td>@c.GrantAmount</td>
                <td class="label">收執聯電話</td>
                <td>@c.ReceiptOfficePhone</td>
            </tr>
        </table>

        <div style="display:flex; gap:20px; margin-top:20px; align-items:flex-start;">
            <div style="flex:1;">
                <div style="font-weight:bold; margin-bottom:8px;">申辦進度查詢網址</div>
                <div>@c.ReceiptQrText</div>
            </div>
            <div style="width:160px; text-align:center;">
                <div class="qr-box">
                    <img src="data:image/png;base64,@Model.QrCodeBase64" alt="QR Code" style="width:120px;height:120px;" />
                </div>
                <div style="margin-top:6px; font-size:12px;">QR Code</div>
            </div>
        </div>

        <div class="footer-note">
            ※ 申請人可憑此收執聯查詢案件進度。<br />
            ※ 如有需要補件或查詢，請洽上方電話。
        </div>

        <div class="sign-line">
            <div>申請人(簽名或蓋章)：____________</div>
            <div>收件人：____________</div>
        </div>
    </div>
</body>
</html>